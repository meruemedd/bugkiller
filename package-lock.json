{
  "name": "bugkiller",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "bugkiller",
      "version": "0.1.0",
      "workspaces": [
        "apps/web",
        "apps/api",
        "packages/shared"
      ],
      "engines": {
        "node": ">=18"
      }
    },
    "apps/api": {
      "name": "@bugkiller/api",
      "version": "0.1.0",
      "dependencies": {
        "@bugkiller/shared": "*"
      }
    },
    "apps/web": {
      "name": "@bugkiller/web",
      "version": "0.1.0",
      "dependencies": {
        "@bugkiller/shared": "*"
      }
    },
    "node_modules/@bugkiller/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@bugkiller/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@bugkiller/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/shared": {
      "name": "@bugkiller/shared",
      "version": "0.1.0"
    }
  }
}
