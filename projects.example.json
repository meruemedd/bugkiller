{
  "projectsRoot": "/你的/电脑/上/三个项目的父目录",
  "debounceMs": 8000,
  "pollIntervalMs": 3000,
  "pullIntervalMs": 60000,
  "autoPull": true,
  "autoPush": true,
  "autoStart": false,
  "autoFix": false,
  "pullMode": "ff-only",
  "commitMessage": "chore(auto): sync {name} @ {time}",
  "projects": [
    {
      "name": "ESIM_B",
      "path": "ESIM_B",
      "remote": "origin",
      "branch": "main",
      "autoPull": true,
      "autoPush": true,
      "enabled": true,
      "start": "npm run dev",
      "healthUrl": "http://127.0.0.1:8080/health"
    },
    {
      "name": "ESIM_A",
      "path": "ESIM_A",
      "remote": "origin",
      "branch": "main",
      "autoPull": true,
      "autoPush": true,
      "enabled": true,
      "start": "echo '[ESIM_A] 用 Android Studio Run，API 指向电脑局域网 IP'"
    },
    {
      "name": "ESIM_I",
      "path": "ESIM_I",
      "remote": "origin",
      "branch": "main",
      "autoPull": true,
      "autoPush": true,
      "enabled": true,
      "start": "echo '[ESIM_I] 用 Xcode Run，API 指向电脑局域网 IP'"
    }
  ]
}
