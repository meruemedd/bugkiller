{
  "name": "bugkiller",
  "private": true,
  "version": "0.1.0",
  "description": "BugKiller 端到端研发工作流：Web + API + Shared，以及 Android/iOS 客户端骨架",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "dev": "bash scripts/dev-all.sh",
    "dev:web": "npm run dev -w @bugkiller/web",
    "dev:api": "npm run dev -w @bugkiller/api",
    "dev:shared": "npm run build -w @bugkiller/shared -- --watch",
    "build": "npm run build -w @bugkiller/shared && npm run build -w @bugkiller/api && npm run build -w @bugkiller/web",
    "pull:dev": "bash scripts/pull-and-dev.sh",
    "watch:projects": "node scripts/watch-and-commit.mjs",
    "watch:dev": "node scripts/watch-and-commit.mjs --with-dev",
    "sync:projects": "node scripts/watch-and-commit.mjs --once",
    "sync:projects:dry": "node scripts/watch-and-commit.mjs --once --dry-run",
    "pull:projects": "node scripts/watch-and-commit.mjs --pull-only",
    "discover:esim": "bash scripts/discover-esim.sh --write",
    "collab": "bash scripts/esim-collab.sh",
    "start:esim": "bash scripts/start-esim-projects.sh --restart",
    "stop:esim": "bash scripts/stop-esim-projects.sh",
    "push:three": "bash scripts/push-three-projects.sh",
    "start:fix": "bash scripts/start-and-fix.sh",
    "auto:fix": "bash scripts/auto-fix.sh",
    "logs:collect": "bash scripts/collect-logs.sh",
    "optimize": "bash scripts/optimize-from-logs.sh",
    "mobile:hint": "bash scripts/mobile-hint.sh"
  },
  "engines": {
    "node": ">=18"
  }
}
